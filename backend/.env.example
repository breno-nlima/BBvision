PORT=3000
NODE_ENV=development
JWT_SECRET=bbvision_takeoff_secret_key_2026_jwt_token_bancodobrasil

# Configurações do Supabase / PostgreSQL
SUPABASE_URL=https://sua-instancia.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
DATABASE_URL=postgresql://postgres:sua-senha@db.sua-instancia.supabase.co:5432/postgres

# Configuração da IA Google Gemini (gemini-1.5-flash)
# Obtenha sua chave gratuita em https://aistudio.google.com/
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_CONFIDENCE_THRESHOLD=0.75

# Configuração de E-mail (Resend / Nodemailer)
# Obtenha sua chave em https://resend.com/
RESEND_API_KEY=sua-chave-resend-aqui
EMAIL_FROM=bbvision-notificacoes@bancodobrasil.com.br
FISCAL_EMAIL_PADRAO=mariana.fiscal@bb.com.br

# Armazenamento e Uploads
UPLOAD_DIR=uploads
