# ==============================================================================
# BBVision - Configuração de Ambiente (.env.example)
# Sistema de Monitoramento e Fiscalização Remota de Obras
# Copie este arquivo para backend/.env e preencha com suas credenciais reais.
# ==============================================================================

# Porta e Ambiente de Execução (Hostinger / Docker / VPS / Local)
PORT=3000
NODE_ENV=production

# URL pública da aplicação (usada em Canonical, Sitemap, robots.txt, llms.txt e MCP Card)
SITE_URL=https://antiquewhite-dolphin-779579.hostingersite.com

# Chave Criptográfica JWT (OBRIGATÓRIO em produção — mínimo 32 caracteres aleatórios)
JWT_SECRET=substitua-por-uma-chave-jwt-aleatoria-com-mais-de-32-caracteres

# Domínios Permitidos para CORS (separados por vírgula em produção, ou '*' em desenvolvimento)
CORS_ORIGIN=https://antiquewhite-dolphin-779579.hostingersite.com

# Banco de Dados PostgreSQL (Supabase)
# Quando configurado, toda persistência ocorre no Supabase.
# Caso não configurado, o backend utiliza armazenamento local persistente em disco (backend/data/bbvision_store.json).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Caminho opcional do arquivo local de persistência (quando Supabase não está configurado)
# DATA_STORE_PATH=backend/data/bbvision_store.json

# Inteligência Artificial (Visão Computacional e Sugestões de Checklist)
# Obtenha sua chave em https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_CONFIDENCE_THRESHOLD=0.75

# Disparo de E-mails Transacionais (Resend via SMTP / Nodemailer)
# Obtenha sua chave em https://resend.com/
RESEND_API_KEY=
EMAIL_FROM=nao-responda@bbvision.com.br
FISCAL_EMAIL_PADRAO=

# Armazenamento e Uploads
UPLOAD_DIR=uploads
