# ==============================================================================
# BBVision - Arquivo de Exemplo de Configuração de Ambiente (.env.example)
# Sistema de Monitoramento e Fiscalização Remota de Obras (Banco do Brasil / TakeOff)
# ==============================================================================

# Porta e Ambiente de Execução (Hostinger / Docker / Local)
PORT=3000
NODE_ENV=production

# Chave Criptográfica JWT (Gere uma chave segura de pelo menos 32 caracteres)
JWT_SECRET=sua-chave-secreta-jwt-super-segura-aqui

# Domínios Permitidos para CORS (separados por vírgula em produção, ou '*' para desenvolvimento)
CORS_ORIGIN=https://bbvision.seusite.com.br,http://localhost:3000

# Configuração do Banco de Dados e Storage (Supabase / PostgreSQL)
# Opcional: caso não configurado, o BBVision utiliza a camada desacoplada em memória automaticamente
SUPABASE_URL=https://seu-projeto-aqui.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Configuração da IA Google Gemini (gemini-1.5-flash)
# Obtenha sua chave gratuita em https://aistudio.google.com/
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_CONFIDENCE_THRESHOLD=0.75

# Configuração de E-mail (Resend / Nodemailer)
# Obtenha sua chave em https://resend.com/
RESEND_API_KEY=sua-chave-resend-aqui
EMAIL_FROM=bbvision-notificacoes@bancodobrasil.com.br
FISCAL_EMAIL_PADRAO=mariana.fiscal@bb.com.br

# Armazenamento e Uploads
UPLOAD_DIR=uploads
